# PromptShield Environment Configuration

# The port PromptShield will run on locally inside the container
PORT=8080

# Target AI Provider API Keys (Optional if client applications pass their own keys in request headers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Fallback default target if model is not recognized
DEFAULT_PROVIDER_URL=https://genergenerativelanguage.googleapis.com/v1beta/openai
